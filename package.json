{
  "name": "wallet-pass-gen",
  "version": "1.0.0",
  "description": "Universal wallet pass generator with layer abstraction for Apple Wallet and Google Wallet — supports pass creation, styling, barcode generation, and tracking",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["wallet", "apple-wallet", "google-wallet", "pkpass", "pass", "loyalty", "ticket", "coupon", "barcode", "qr-code"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "google-auth-library": "^9.14.2",
    "axios": "^1.7.2",
    "bwip-js": "^4.11.1",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.3.1",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
